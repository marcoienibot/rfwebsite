		{
			"slug": "page_header",
			"label": "Page header",
			"description": "The dark blue introduction at the top of a page",
			"category": "Rust Foundation",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "headline",
							"label": "Headline",
							"type": "string",
							"required": true
						},
						{
							"slug": "intro",
							"label": "Introduction (blank line = new paragraph, “- ” = list item, [text](https://…) = link)",
							"type": "text"
						},
						{
							"slug": "icon",
							"label": "Small round icon next to the introduction",
							"type": "image"
						},
						{
							"slug": "jump_links",
							"label": "“Jump to” links",
							"type": "repeater",
							"validation": {
								"subFields": [
									{
										"slug": "label",
										"label": "Text",
										"type": "string",
										"required": true
									},
									{
										"slug": "url",
										"label": "Link (usually #section-id) (starts with /, https://, mailto: or #)",
										"type": "string"
									}
								]
							}
						},
						{
							"slug": "buttons",
							"label": "Buttons",
							"type": "repeater",
							"validation": {
								"subFields": [
									{
										"slug": "label",
										"label": "Text",
										"type": "string",
										"required": true
									},
									{
										"slug": "url",
