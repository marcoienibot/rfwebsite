---
import { Font } from "astro:assets";
import { getMenu, getSiteSettings } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { linkAttrs } from "../utils/links";
import { resolveSiteIdentity } from "../utils/site";
import "../styles/site.css";

interface Props {
	title?: string;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	/** Skip the dark header band below the navigation (pages that start with their own). */
	pageType?: "website" | "article";
}

const { title, description, image, canonical, robots, content, pageType = "website" } = Astro.props;

const [settings, announcement, headerLinks, primary, footer, footerLegal, social] = await Promise.all([
	getSiteSettings(),
	getMenu("announcement"),
	getMenu("header"),
	getMenu("primary"),
	getMenu("footer"),
	getMenu("footer_legal"),
	getMenu("social"),
]);

const { siteTitle, siteTagline, titleSeparator } = resolveSiteIdentity(settings);
const fullTitle = title && title !== siteTitle ? `${title} ${titleSeparator} ${siteTitle}` : siteTitle;
const site = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(path.replace(/^\//, ""), site.href.endsWith("/") ? site : `${site.href}/`).href;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType,
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description || siteTagline || undefined,
	canonical: canonical ?? absolute(Astro.url.pathname),
	image: image ? absolute(image) : undefined,
	content,
	seo: { ogImage: image ? absolute(image) : undefined, robots },
	siteName: siteTitle,
});

const announcementLink = announcement?.items[0];
const year = new Date().getFullYear();

const SOCIAL_ICONS: Record<string, string> = {
	linkedin:
		"M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z",
	bluesky:
		"M5.2 2.6C7.95 4.67 10.92 8.85 12 11.1c1.08-2.25 4.05-6.43 6.8-8.5 1.99-1.49 5.2-2.64 5.2 1.03 0 .73-.42 6.15-.67 7.03-.85 3.05-3.96 3.83-6.73 3.36 4.84.82 6.07 3.56 3.41 6.29-5.05 5.18-7.26-1.3-7.82-2.96l-.19-.55-.19.55c-.56 1.66-2.77 8.14-7.82 2.96-2.66-2.73-1.43-5.47 3.41-6.29-2.77.47-5.88-.31-6.73-3.36C.42 9.78 0 4.36 0 3.63 0-.04 3.21 1.11 5.2 2.6z",
	mastodon:
		"M23.27 5.31C22.9 2.56 20.5.4 17.64 0 17.16-.08 15.34-.33 11.14-.33h-.03c-4.21 0-5.11.25-5.6.33C2.73.38.21 2.36-.4 5.15c-.3 1.37-.33 2.9-.27 4.29.08 2 .1 4 .28 5.99.13 1.32.35 2.63.66 3.92.58 2.37 2.92 4.34 5.21 5.14 2.45.84 5.09.98 7.62.4.28-.06.55-.14.83-.22.61-.2 1.33-.42 1.86-.8l.02-.02v-1.88s0-.01-.02-.01c-1.6.38-3.25.57-4.9.57-2.83 0-3.6-1.35-3.81-1.91-.17-.48-.28-.99-.33-1.5 0-.02.01-.03.02-.03 1.58.38 3.19.57 4.81.57h1.17c1.63-.04 3.35-.13 4.95-.44l.12-.03c2.53-.48 4.94-2 5.18-5.83.01-.15.03-1.58.03-1.73 0-.53.17-3.78-.03-5.77zm-3.8 9.33h-2.66V8.21c0-1.36-.57-2.05-1.72-2.05-1.27 0-1.9.82-1.9 2.44v3.53h-2.64V8.6c0-1.62-.63-2.44-1.9-2.44-1.14 0-1.71.69-1.71 2.05v6.43H4.28V8.02c0-1.36.35-2.43 1.04-3.23.71-.8 1.65-1.2 2.81-1.2 1.35 0 2.36.52 3.04 1.55L11.83 6.24l.66-1.1c.68-1.03 1.7-1.55 3.04-1.55 1.16 0 2.1.4 2.81 1.2.69.8 1.04 1.87 1.04 3.23v6.62z",
	github:
		"M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3",
	youtube:
		"M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z",
};
const socialIcon = (label: string) => SOCIAL_ICONS[label.toLowerCase().replace(/[^a-z]/g, "")];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<link rel="icon" href="/favicon.png" type="image/png" />
		<link rel="alternate" type="application/rss+xml" title={`${siteTitle} news`} href="/feed.xml" />
		<Font cssVariable="--font-noto-sans" preload />
		<Font cssVariable="--font-noto-serif" preload />
		<EmDashHead page={pageCtx} />
		<slot name="head" />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>

		{
			announcementLink && (
				<div class="announce" data-announce hidden>
					<a {...linkAttrs(announcementLink.url)} class="announce__link">
						{announcementLink.label}
					</a>
					<button type="button" class="announce__close" aria-label="Dismiss announcement" data-announce-close>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
					</button>
				</div>
			)
		}

		<header class="site-header">
			<div class="site-header__bar">
				<a href="/" class="site-header__logo" aria-label={`${siteTitle} home`}>
					<img src="/theme/logo-white.svg" alt="" width="181" height="131" />
				</a>
				<div class="site-header__actions">
					{
						headerLinks?.items.map((item) => (
							<a {...linkAttrs(item.url)} class="btn btn--outline btn--small site-header__pill">
								{item.label}
							</a>
						))
					}
					<button
						type="button"
						class="menu-toggle"
						aria-expanded="false"
						aria-controls="site-menu"
						data-menu-toggle
					>
						<span class="visually-hidden">Menu</span>
						<svg class="menu-toggle__open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
						<svg class="menu-toggle__close" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17" /></svg>
					</button>
				</div>
			</div>
			<nav id="site-menu" class="mega" aria-label="Main" hidden>
				{
					primary?.items.map((column) => {
						const isButtonColumn = column.cssClasses?.includes("button");
						return (
							<div class="mega__column">
								{isButtonColumn ? (
									<a {...linkAttrs(column.url)} class="btn mega__cta">
										{column.label}
									</a>
								) : (
									<a {...linkAttrs(column.url)} class="mega__heading">
										{column.label}
									</a>
								)}
								<ul>
									{column.children.map((item) => (
										<li>
											<a {...linkAttrs(item.url)}>{item.label}</a>
										</li>
									))}
								</ul>
							</div>
						);
					})
				}
			</nav>
		</header>

		<main id="main" data-pagefind-body={content ? "" : undefined}>
			<slot />
		</main>

		<footer class="site-footer bg-teal">
			<div class="container">
				<div class="site-footer__top">
					<div class="site-footer__about">
						<a href="/" class="site-footer__logo" aria-label={`${siteTitle} home`}>
							<img src="/theme/logo-white.svg" alt="" width="181" height="131" loading="lazy" />
						</a>
						{siteTagline && <p class="site-footer__tagline">{siteTagline}</p>}
						{
							social && social.items.length > 0 && (
								<>
									<p class="site-footer__follow">Follow the Rust Foundation on:</p>
									<ul class="social">
										{social.items.map((item) => (
											<li>
												<a href={item.url} target="_blank" rel="noopener me" aria-label={item.label}>
													{socialIcon(item.label) ? (
														<svg viewBox="0 0 24 24" aria-hidden="true">
															<path d={socialIcon(item.label)} />
														</svg>
													) : (
														item.label
													)}
												</a>
											</li>
										))}
									</ul>
								</>
							)
						}
					</div>
					<ul class="site-footer__links">
						{
							footer?.items.map((item) => (
								<li>
									<a {...linkAttrs(item.url)}>{item.label}</a>
								</li>
							))
						}
					</ul>
				</div>
				<ul class="site-footer__legal">
					{
						footerLegal?.items.map((item) => (
							<li>
								<a {...linkAttrs(item.url)}>{item.label}</a>
							</li>
						))
					}
				</ul>
				<div class="site-footer__bottom">
					<img src="/theme/emblem.png" alt="" width="40" height="40" loading="lazy" class="site-footer__mark" />
					<p>
						Copyright © {year} the Rust Foundation. All rights reserved. The Rust Foundation has registered
						trademarks and uses trademarks. For a list of trademarks of the Rust Foundation, please see the{" "}
						<a href="/policy/rust-trademark-policy/">Trademark Policy</a>.
					</p>
				</div>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
			const menu = document.getElementById("site-menu");
			toggle?.addEventListener("click", () => {
				const open = toggle.getAttribute("aria-expanded") !== "true";
				toggle.setAttribute("aria-expanded", String(open));
				if (menu) menu.hidden = !open;
			});
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
					toggle.click();
					toggle.focus();
				}
			});

			const banner = document.querySelector<HTMLElement>("[data-announce]");
			const bannerKey = `announce:${banner?.querySelector("a")?.textContent?.trim()}`;
			if (banner && localStorage.getItem(bannerKey) !== "dismissed") banner.hidden = false;
			banner?.querySelector("[data-announce-close]")?.addEventListener("click", () => {
				banner.hidden = true;
				localStorage.setItem(bannerKey, "dismissed");
			});
		</script>
	</body>
</html>

<style>
	.announce {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 4.25rem;
		padding: 0.75rem var(--gutter);
		background: var(--rust) url("/theme/cog.png") no-repeat -1rem -1.5rem / 9rem;
		background-blend-mode: soft-light;
	}

	.announce[hidden] {
		display: none;
	}

	.announce__link {
		color: var(--white);
		font-size: 1.25rem;
		text-underline-offset: 3px;
	}

	.announce__link::before {
		content: ">> ";
	}

	.announce__link:hover {
		color: var(--white);
		text-decoration-thickness: 2px;
	}

	.announce__close {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: 50%;
		background: var(--white);
		cursor: pointer;
	}

	.announce__close svg,
	.menu-toggle svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
	}

	.site-header {
		color: var(--white);
		background: var(--navy) url("/theme/header-pattern.png") no-repeat right -2rem top -3rem / auto 22rem;
	}

	.site-header__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.25rem var(--gutter);
	}

	.site-header__logo img {
		display: block;
		width: clamp(5.5rem, 12vw, 11.25rem);
		height: auto;
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.site-header__pill {
		color: var(--white);
	}

	.menu-toggle {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: 50%;
		color: var(--white);
		background: transparent;
		cursor: pointer;
	}

	.menu-toggle[aria-expanded="true"] {
		background: var(--rust);
	}

	.menu-toggle__close,
	.menu-toggle[aria-expanded="true"] .menu-toggle__open {
		display: none;
	}

	.menu-toggle[aria-expanded="true"] .menu-toggle__close {
		display: block;
	}

	.mega {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 1.5rem 2rem;
		padding: 0.5rem var(--gutter) 3rem;
	}

	.mega[hidden] {
		display: none;
	}

	.mega__column {
		padding-top: 1rem;
		border-top: 1px solid var(--rust);
	}

	.mega__heading {
		display: inline-block;
		margin-bottom: 0.75rem;
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--white);
		text-decoration: none;
	}

	.mega__cta {
		margin-bottom: 1rem;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.mega ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.mega li {
		margin-bottom: 0.8rem;
	}

	.mega li a {
		color: var(--white);
		font-size: 1.05rem;
		text-decoration: none;
	}

	.mega a:hover {
		color: var(--white);
		text-decoration: underline;
	}

	@media (max-width: 40rem) {
		.site-header__pill {
			display: none;
		}

		.mega {
			grid-template-columns: 1fr 1fr;
			gap: 1rem 1.25rem;
		}

		.mega__heading,
		.mega__cta {
			font-size: 1rem;
		}

		.mega li {
			margin-bottom: 0.6rem;
		}

		.mega li a {
			font-size: 0.9rem;
		}
	}

	.site-footer {
		padding-block: 3rem 2rem;
		font-size: 0.875rem;
	}

	.site-footer a {
		color: var(--white);
		text-decoration: none;
	}

	.site-footer a:hover {
		text-decoration: underline;
	}

	.site-footer__logo img {
		display: block;
		width: 11.25rem;
		height: auto;
		margin-bottom: 1rem;
	}

	.site-footer__top {
		display: grid;
		grid-template-columns: minmax(12rem, 1fr) 3fr;
		gap: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(255 255 255 / 0.4);
	}

	.site-footer__tagline,
	.site-footer__follow {
		font-family: var(--font-serif);
		font-size: 1rem;
		line-height: 1.4;
	}

	.site-footer__links,
	.site-footer__legal {
		display: grid;
		grid-auto-flow: column;
		grid-template-rows: repeat(4, auto);
		align-content: start;
		gap: 0.75rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__links {
		padding-top: 4.5rem;
	}

	.site-footer__legal {
		grid-template-rows: repeat(2, auto);
		margin-top: 3rem;
		padding-block: 1.5rem;
		border-block: 1px solid rgb(255 255 255 / 0.4);
		font-size: 0.8rem;
	}

	.social {
		display: flex;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.social svg {
		width: 1.6rem;
		height: 1.6rem;
		fill: currentColor;
	}

	.site-footer__bottom {
		padding-top: 1.5rem;
		font-family: var(--font-serif);
		font-size: 0.8rem;
	}

	.site-footer__bottom a {
		text-decoration: underline;
	}

	.site-footer__mark {
		display: block;
		margin: 0 auto 1.5rem;
	}

	@media (max-width: 50rem) {
		.site-footer__top {
			grid-template-columns: 1fr;
		}

		.site-footer__links {
			padding-top: 0;
		}

		.site-footer__links,
		.site-footer__legal {
			grid-auto-flow: row;
			grid-template-columns: repeat(2, 1fr);
			grid-template-rows: none;
		}
	}
</style>
