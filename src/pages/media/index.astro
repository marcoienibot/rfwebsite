---
import PostListing from "../../components/PostListing.astro";
import Base from "../../layouts/Base.astro";
import { allPosts } from "../../utils/content";

const posts = await allPosts();
---

<Base title="Media Room" description="Announcements, blogs, media pieces, and publications from the Rust Foundation.">
	<PostListing posts={posts} page={1} href={(n) => (n === 1 ? "/media/" : `/media/page/${n}/`)} feature />
</Base>
