---
import { getTaxonomyTerms } from "emdash";
import PostListing, { PER_PAGE } from "../../../../../components/PostListing.astro";
import Base from "../../../../../layouts/Base.astro";
import { postsWhere } from "../../../../../utils/content";

export async function getStaticPaths() {
	const paths = [];
	for (const term of await getTaxonomyTerms("tag")) {
		const pages = Math.ceil((await postsWhere({ tag: term.slug })).length / PER_PAGE);
		for (let page = 2; page <= pages; page++) {
			paths.push({ params: { slug: term.slug, page: String(page) } });
		}
	}
	return paths;
}

const { slug } = Astro.params;
const page = Number(Astro.params.page);
const term = (await getTaxonomyTerms("tag")).find((t) => t.slug === slug);
if (!term) return Astro.rewrite("/404");
const label = term.label;
const posts = await postsWhere({ tag: slug });
---

<Base title={`${label} – page ${page}`}>
	<PostListing posts={posts} page={page} heading={label} href={(n) => (n === 1 ? `/media/tag/${slug}/` : `/media/tag/${slug}/page/${n}/`)} />
</Base>
