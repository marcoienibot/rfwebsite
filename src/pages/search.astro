---
import Base from "../layouts/Base.astro";
---

<Base title="Search" robots="noindex">
	<section class="search-hero bg-navy">
		<div class="container--narrow">
			<h1>Search</h1>
			<p>Search news, blog posts, policies and pages.</p>
		</div>
	</section>
	<section class="container--narrow search">
		<!-- Pagefind's UI is loaded by Base.astro. Its own instance keeps this page's query apart from the header's search dialog. -->
		<pagefind-input instance="page"></pagefind-input>
		<pagefind-summary instance="page"></pagefind-summary>
		<pagefind-results instance="page"></pagefind-results>
		<noscript>Search needs JavaScript.</noscript>
		{
			import.meta.env.DEV && (
				<p>The search index is created when the website is built, so search only works on the published site.</p>
			)
		}
	</section>
</Base>

<script>
	customElements.whenDefined("pagefind-input").then(() => {
		const instance = window.PagefindComponents.getInstanceManager().getInstance("page");
		// Links to /search/?q=… (from the post listings) arrive with results. Otherwise the
		// cursor waits in the empty search field.
		const query = new URLSearchParams(location.search).get("q");
		if (query) instance.triggerSearch(query);
		else document.querySelector<HTMLInputElement>(".search input")?.focus();
		// Keep the query in the URL so that a search can be shared, reloaded and returned to.
		instance.on("search", (term) => {
			const url = new URL(location.href);
			if (term) url.searchParams.set("q", term);
			else url.searchParams.delete("q");
			history.replaceState(history.state, "", url);
		});
	});
</script>

<style>
	.search-hero {
		padding-block: 3rem;
	}

	.search {
		padding-block: 2.5rem 4rem;
		--pf-input-height: 3rem;
		--pf-input-font-size: 1.125rem;
		--pf-summary-font-size: 0.875rem;
		--pf-result-title-font-size: 1.125rem;
		--pf-result-excerpt-font-size: 0.95rem;
	}

	pagefind-summary {
		margin-block: 1rem 0.5rem;
	}
</style>
