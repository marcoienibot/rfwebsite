---
import Base from "../layouts/Base.astro";
---

<Base title="Search" robots="noindex">
	<link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
	<section class="search-hero bg-navy">
		<div class="container--narrow">
			<h1>Search</h1>
			<p>Search news, blog posts, policies and pages.</p>
		</div>
	</section>
	<section class="container--narrow search">
		<!-- The href is rewritten for sub-path deployments; search results use it as their base. -->
		<a id="search-base" href="/" hidden></a>
		<div id="search"></div>
		<noscript>Search needs JavaScript.</noscript>
		<p class="search__dev" hidden>The search index is created when the website is built, so search only works on the published site.</p>
	</section>
	<script is:inline type="module">
		const base = new URL(document.getElementById("search-base").href).pathname;
		try {
			await import(`${base}pagefind/pagefind-ui.js`);
			const query = new URLSearchParams(location.search).get("q") ?? "";
			const ui = new PagefindUI({ element: "#search", baseUrl: base, showSubResults: true, showImages: false });
			if (query) ui.triggerSearch(query);
		} catch {
			document.querySelector(".search__dev").hidden = false;
		}
	</script>
</Base>

<style>
	.search-hero {
		padding-block: 3rem;
	}

	.search {
		padding-block: 2.5rem 4rem;
		--pagefind-ui-primary: var(--navy);
		--pagefind-ui-font: var(--font-sans);
		--pagefind-ui-border-radius: 0;
	}
</style>
