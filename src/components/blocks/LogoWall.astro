---
import Carousel from "../Carousel.astro";
import LogoTile, { type Logo } from "../LogoTile.astro";
import Paragraphs from "../Paragraphs.astro";
import { organizations } from "../../utils/content";
import { linkAttrs } from "../../utils/links";

const { value } = Astro.props;
let logos: Logo[] = value.logos ?? [];
const picked = !value.source || value.source === "pick below";
if (!picked) {
	logos = (await organizations(value.source)).map((org) => ({
		name: org.data.title,
		logo: org.data.logo,
		url: org.data.website ?? undefined,
		id: `${value._key ?? value.source}-${org.id}`,
		joined: org.data.joined,
		bio: org.data.bio,
	}));
}
const label = value.headline || (picked ? "Logos" : value.source.replaceAll("-", " ").replace(/^./, (c: string) => c.toUpperCase()));
---

<section
	id={value.anchor_id || undefined}
	class:list={["section logos", `bg-${value.background ?? "white"}`, { "logos--continued": !value.headline && !value.text }]}
>
	<div class="container">
		{value.headline && <h2 class="heading-center">{value.headline}</h2>}
		<Paragraphs text={value.text} class="logos__text" />
		{
			/* A carousel keeps long walls (like the silver members) to one row. */
			value.layout === "carousel" ? (
				<Carousel label={label} class="logo-grid logo-grid--carousel">
					{logos.map((item) => <LogoTile item={item} />)}
				</Carousel>
			) : (
				<ul class:list={["logo-grid", { "logo-grid--showcase": picked }]}>
					{logos.map((item) => <LogoTile item={item} />)}
				</ul>
			)
		}
		{
			value.buttons?.length > 0 && (
				<div class="btn-row btn-row--center">
					{value.buttons.map((button: { label: string; url?: string }) => (
						<a {...linkAttrs(button.url)} class="btn btn--small">
							{button.label}
						</a>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.logos {
		padding-block: clamp(2rem, 4vw, 3rem);
	}

	/* A wall without a heading continues the one above it (e.g. one per tier). */
	.logos--continued {
		padding-top: 0;
	}

	.logos:has(+ .logos--continued) {
		padding-bottom: 0;
	}

	.logos :global(.logos__text) {
		max-width: 60rem;
		margin-inline: auto;
		text-align: center;
	}
</style>
