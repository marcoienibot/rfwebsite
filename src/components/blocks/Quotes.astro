---
import Carousel from "../Carousel.astro";
import Quote, { type QuoteItem } from "../Quote.astro";

const { value } = Astro.props;
const items: QuoteItem[] = value.items ?? [];
---

<section id={value.anchor_id || undefined} class:list={["section quotes", `bg-${value.background ?? "white"}`]}>
	<div class="container">
		{value.headline && <h2 class="heading-center">{value.headline}</h2>}
		{
			/* Longer lists page through two at a time, like the old carousel. */
			items.length > 4 ? (
				<Carousel label={value.headline || "Quotes"} class="quotes__carousel">
					{items.map((item) => (
						<li>
							<Quote item={item} />
						</li>
					))}
				</Carousel>
			) : (
				<div class:list={["quotes__list", { "quotes__list--single": items.length === 1 }]}>
					{items.map((item) => <Quote item={item} />)}
				</div>
			)
		}
	</div>
</section>

<style>
	.quotes__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
		gap: 2rem 2.5rem;
	}

	.quotes__list--single {
		max-width: 56rem;
		margin-inline: auto;
	}

	.quotes__list--single :global(blockquote) {
		font-size: clamp(1.25rem, 2.2vw, 1.6rem);
	}

	.quotes :global(.quotes__carousel) {
		--per-page: 1;
		--carousel-gap: 2.5rem;
		align-items: start;
	}

	@media (min-width: 62rem) {
		.quotes :global(.quotes__carousel) {
			--per-page: 2;
		}
	}
</style>
