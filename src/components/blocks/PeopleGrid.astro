---
import Paragraphs from "../Paragraphs.astro";
import Img from "../Img.astro";
import { people } from "../../utils/content";
import { profileLinks } from "../../utils/social";

const { value } = Astro.props;
const list = await people(value.group ?? "staff");
const initials = (name: string) =>
	name
		.replace(/^(Dr|Mr|Ms|Mrs)\.?\s+/, "")
		.split(/\s+/)
		.map((part) => part[0])
		.slice(0, 2)
		.join("");
---

<section id={value.anchor_id || undefined} class="section people">
	<div class="container">
		<h2 class="heading-center">{value.headline}</h2>
		<Paragraphs text={value.text} class="people__text" />
		<ul class="people__grid">
			{
				list.map((person) => {
					const popoverId = `bio-${value._key ?? value.group}-${person.id}`;
					const bio = person.data.bio?.trim();
					const links = profileLinks(person.data.links);
					return (
						<li class="person">
							{person.data.photo ? (
								<Img image={person.data.photo} alt="" class="person__photo" />
							) : (
								<span class="person__photo person__photo--placeholder" aria-hidden="true">
									{initials(person.data.title)}
								</span>
							)}
							<h3 class="person__name">{person.data.title}</h3>
							{person.data.role && <p class="person__role">{person.data.role}</p>}
							{(bio || links.length > 0) && (
								<>
									<button type="button" class="arrow-link person__more" popovertarget={popoverId}>
										<span class="visually-hidden">About {person.data.title}</span>
										<svg viewBox="0 0 21 16" aria-hidden="true">
											<path d="M0 8h19M13 1.5 19.5 8 13 14.5" fill="none" stroke="currentColor" />
										</svg>
									</button>
									<div id={popoverId} popover class="bio">
										<button type="button" class="bio__close" popovertarget={popoverId} popovertargetaction="hide">
											<span class="visually-hidden">Close</span>×
										</button>
										<div class="bio__grid">
											<Img image={person.data.photo} alt="" class="person__photo" />
											<div>
												<h3>{person.data.title}</h3>
												{person.data.role && <p class="person__role">{person.data.role}</p>}
												{links.length > 0 && (
													<ul class="bio__links">
														{links.map((link) => (
															<li>
																<a
																	href={link.url}
																	target="_blank"
																	rel="noopener"
																	aria-label={`${person.data.title} on ${link.network}`}
																	title={link.network}
																>
																	<svg viewBox={link.viewBox} aria-hidden="true">
																		<path d={link.icon} />
																	</svg>
																</a>
															</li>
														))}
													</ul>
												)}
												<Paragraphs text={bio} />
											</div>
										</div>
									</div>
								</>
							)}
						</li>
					);
				})
			}
		</ul>
		<Paragraphs text={value.note} class="people__note" />
	</div>
</section>

<style>
	.people {
		padding-block: 2rem;
	}

	.people :global(.people__text) {
		max-width: 60rem;
		margin-inline: auto;
		text-align: center;
	}

	.people__grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.25rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.person {
		color: var(--ink);
		display: flex;
		flex-direction: column;
		align-items: center;
		width: min(100%, 19rem);
		padding: 1.25rem 1.25rem 1rem;
		text-align: center;
		background: var(--rust-10);
	}

	.person :global(.person__photo) {
		width: 12rem;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 50%;
		margin-bottom: 1rem;
	}

	.person__photo--placeholder {
		display: grid;
		place-items: center;
		font-family: var(--font-serif);
		font-size: 3rem;
		color: var(--white);
		background: var(--navy) url("/theme/cog.png") no-repeat center / 70%;
		background-blend-mode: soft-light;
	}

	.person__name {
		margin-bottom: 0.4rem;
		font-size: 1.35rem;
		font-weight: 700;
	}

	.person__role {
		font-weight: 700;
		font-size: 0.95rem;
	}

	.person__more {
		align-self: flex-start;
		margin-top: auto;
		background: none;
		cursor: pointer;
	}

	.people :global(.people__note) {
		max-width: 75rem;
		margin: 1.25rem auto 0;
		font-size: 0.8rem;
		font-style: italic;
	}

	.bio {
		width: min(100% - 2rem, 50rem);
		max-height: 85vh;
		padding: 2rem;
		border: 0;
		box-shadow: 0 10px 40px rgb(0 0 0 / 0.3);
	}

	.bio::backdrop {
		background: rgb(30 38 80 / 0.6);
	}

	.bio__grid {
		display: grid;
		grid-template-columns: 10rem 1fr;
		gap: 1.5rem;
	}

	.bio__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin: 0.25rem 0 1rem;
		padding: 0;
		list-style: none;
	}

	.bio__links a {
		display: block;
		color: var(--navy);
	}

	.bio__links a:hover {
		color: var(--rust);
	}

	.bio__links svg {
		display: block;
		width: 1.5rem;
		height: 1.5rem;
		fill: currentColor;
	}

	.bio__close {
		position: absolute;
		top: 0.5rem;
		right: 0.75rem;
		border: 0;
		background: none;
		font-size: 2rem;
		line-height: 1;
		cursor: pointer;
	}

	@media (max-width: 40rem) {
		.bio__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
