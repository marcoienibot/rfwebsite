---
import Carousel from "../Carousel.astro";
import PostCard from "../PostCard.astro";
import { allPosts, postsWhere } from "../../utils/content";
import { linkAttrs } from "../../utils/links";

const { value } = Astro.props;
// Hand-picked posts (one link or slug per line) win over the tag.
const picked = String(value.posts ?? "")
	.split("\n")
	.map((line) => line.trim().replace(/\/+$/, "").split("/").pop())
	.filter(Boolean);
const all = picked.length ? await allPosts() : [];
const posts = picked.length
	? picked.flatMap((slug) => all.filter((post) => post.id === slug))
	: (await postsWhere({ tag: value.tag || undefined })).slice(0, value.count || 4);
---

<section id={value.anchor_id || undefined} class:list={["section", `bg-${value.background ?? "white"}`]}>
	<div class="container">
		<h2 class="heading-center">{value.headline}</h2>
		{
			/* Longer lists page through four at a time, like the old carousels. */
			posts.length > 4 ? (
				<Carousel label={value.headline} class="post-grid post-grid--carousel">
					{posts.map((post) => (
						<li>
							<PostCard post={post} />
						</li>
					))}
				</Carousel>
			) : (
				<div class:list={["post-grid", { "post-grid--few": posts.length < 4 }]}>
					{posts.map((post) => <PostCard post={post} />)}
				</div>
			)
		}
		{
			value.buttons?.length > 0 && (
				<div class="btn-row btn-row--center more">
					{value.buttons.map((button: { label: string; url?: string }) => (
						<a {...linkAttrs(button.url)} class="btn btn--small">
							{button.label}
						</a>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.more {
		margin-top: 2rem;
	}
</style>
