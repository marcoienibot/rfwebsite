---
import { videoPlayer } from "../../utils/video";
import VideoEmbed from "../VideoEmbed.astro";

const { value } = Astro.props;
const player = videoPlayer(value.url);
---

{
	player && (
		<section id={value.anchor_id || undefined} class="section video">
			<div class="container--narrow">
				{value.headline && <h2 class="heading-center">{value.headline}</h2>}
				<VideoEmbed player={player} title={value.headline} />
			</div>
		</section>
	)
}
