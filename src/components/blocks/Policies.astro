---
import { allEntries } from "../../utils/content";
import { policyUrl } from "../../utils/links";

const { value } = Astro.props;
const policies = (await allEntries("policies")).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<section id={value.anchor_id || undefined} class="section policies">
	<div class="container">
		{value.headline && <h2 class="heading-center">{value.headline}</h2>}
		<ul class="policies__grid">
			{
				policies.map((policy) => (
					<li>
						<a href={policyUrl(policy.id)}>{policy.data.title}</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.policies__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		gap: 0.75rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.policies__grid a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 100%;
		padding: 1.25rem 1.5rem;
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--ink);
		background: var(--rust-10);
		text-decoration: none;
	}

	.policies__grid a::after {
		content: "→";
		color: var(--rust);
	}

	.policies__grid a:hover {
		background: #f6dad0;
		text-decoration: underline;
	}
</style>
