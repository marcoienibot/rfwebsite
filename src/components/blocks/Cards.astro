---
import Img from "../Img.astro";
import { linkAttrs } from "../../utils/links";
import { paragraphs } from "../../utils/text";

const { value } = Astro.props;
---

<section id={value.anchor_id || undefined} class:list={["section", `bg-${value.background ?? "white"}`]}>
	<div class="container">
		{value.headline && <h2 class="heading-center">{value.headline}</h2>}
		{paragraphs(value.text).map((p) => <p class="cards__text">{p}</p>)}
		<ul class:list={["cards", `cards--${value.style ?? "boxed"}`]}>
			{
				value.cards?.map((card: { title: string; text?: string; image?: never; url?: string; link_label?: string }) => (
					<li class="cards__item">
						{card.image && <Img image={card.image} class="cards__image" />}
						<h3>{card.url ? <a {...linkAttrs(card.url)}>{card.title}</a> : card.title}</h3>
						{paragraphs(card.text).map((p) => <p>{p}</p>)}
						{card.url && card.link_label && (
							<a {...linkAttrs(card.url)} class="cards__link">
								{card.link_label}
							</a>
						)}
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.cards__text {
		max-width: 60rem;
		margin-inline: auto;
		text-align: center;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1.25rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.cards--boxed .cards__item {
		padding: 1.5rem;
		background: var(--rust-10);
	}

	.cards--plain .cards__item {
		text-align: center;
	}

	.cards__item h3 {
		font-size: 1.35rem;
	}

	.cards__item h3 a {
		color: inherit;
		text-decoration: none;
	}

	.cards__item h3 a:hover {
		text-decoration: underline;
	}

	.cards__item :global(.cards__image) {
		display: block;
		width: 100%;
		max-height: 12rem;
		object-fit: contain;
		margin-bottom: 1rem;
	}

	.cards__item p {
		font-size: 0.95rem;
	}

	.cards__link {
		font-size: 0.9rem;
	}
</style>
