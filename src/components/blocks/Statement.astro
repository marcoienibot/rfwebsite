---
import Paragraphs from "../Paragraphs.astro";
import { linkAttrs } from "../../utils/links";

const { value } = Astro.props;
const text = value.label ? `**${value.label}** ${value.text ?? ""}` : value.text;
---

<section id={value.anchor_id || undefined} class:list={["statement section", `bg-${value.background ?? "light"}`]}>
	<div class="container">
		<div class="statement__text">
			<Paragraphs text={text} />
		</div>
		{
			value.buttons?.length > 0 && (
				<div class="btn-row btn-row--center">
					{value.buttons.map((button: { label: string; url?: string }) => (
						<a {...linkAttrs(button.url)} class="btn btn--small">
							{button.label}
						</a>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.statement {
		padding-block: 2.5rem;
	}

	.statement__text :global(p:first-child) {
		font-size: 1.15rem;
	}

	.statement__text :global(p:first-child strong:first-child) {
		margin-right: 0.35em;
		font-family: var(--font-serif);
		font-size: 1.6rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.btn-row {
		margin-top: 1.5rem;
	}
</style>
