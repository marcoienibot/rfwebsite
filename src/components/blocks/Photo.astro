---
import Img from "../Img.astro";

const { value } = Astro.props;
---

<figure class="photo">
	<Img image={value.image} />
	{value.caption && <figcaption>{value.caption}</figcaption>}
</figure>

<style>
	.photo {
		width: min(100% - 2 * var(--gutter), var(--content));
		margin: clamp(1.5rem, 4vw, 2.5rem) auto;
	}

	.photo :global(img) {
		display: block;
		width: 100%;
		max-height: 34rem;
		object-fit: cover;
	}

	figcaption {
		margin-top: 0.5rem;
		font-size: 0.85rem;
		color: var(--muted);
		text-align: center;
	}
</style>
