---
import Img from "../Img.astro";

const { value } = Astro.props;
const { width, height } = value.image ?? {};
---

<figure class="photo" style={width && height ? `--ratio: ${width / height}` : undefined}>
	<Img image={value.image} />
	{value.caption && <figcaption>{value.caption}</figcaption>}
</figure>

<style>
	.photo {
		width: min(100% - 2 * var(--gutter), var(--content));
		margin: clamp(1.5rem, 4vw, 2.5rem) auto;
	}

	/* Whole image, never cropped; very tall or large photos are scaled down.
	   Capping the width (not the height) keeps the space reserved from the
	   image's width and height before it loads, so the page doesn't jump. */
	.photo :global(img) {
		display: block;
		max-width: min(100%, 38rem * var(--ratio, 100));
		height: auto;
		max-height: 38rem;
		margin-inline: auto;
	}

	figcaption {
		margin-top: 0.5rem;
		font-size: 0.85rem;
		color: var(--muted);
		text-align: center;
	}
</style>
