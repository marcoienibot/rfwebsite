---
/**
 * A YouTube or Vimeo video that loads only when the visitor clicks play.
 * Until then nothing is requested from YouTube or Vimeo, so they can't set
 * cookies or store anything in the browser, and the site needs no cookie banner.
 */
import type { VideoPlayer } from "../utils/video";

interface Props {
	player: VideoPlayer;
	title?: string;
}

const { player, title } = Astro.props;
---

<div class="video-embed" data-video-embed={player.embedUrl} data-video-title={title || `${player.provider} video`}>
	<button type="button" class="video-embed__play">
		<svg class="video-embed__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5v14l11-7z"></path></svg>
		<span>Play video{title && <span class="visually-hidden">: {title}</span>}</span>
	</button>
	<p class="video-embed__note">
		Playing loads the video from {player.provider}, which may set cookies.{" "}
		<a href={player.watchUrl} target="_blank" rel="noopener">Watch on {player.provider}</a>
	</p>
</div>

<script>
	for (const embed of document.querySelectorAll<HTMLElement>("[data-video-embed]")) {
		embed.querySelector("button")?.addEventListener("click", () => {
			const iframe = document.createElement("iframe");
			iframe.src = embed.dataset.videoEmbed!;
			iframe.title = embed.dataset.videoTitle!;
			iframe.allow = "autoplay; encrypted-media; fullscreen; picture-in-picture";
			iframe.allowFullscreen = true;
			embed.replaceChildren(iframe);
			iframe.focus();
		});
	}
</script>

<style>
	.video-embed {
		position: relative;
		aspect-ratio: 16 / 9;
		color: var(--white);
		background-color: var(--navy);
		background-image: url("/theme/cog.png"), var(--grain);
		background-repeat: no-repeat, repeat;
		background-position:
			right -4rem bottom -5rem,
			0 0;
		background-size: 18rem, auto;
		background-blend-mode: soft-light;
	}

	.video-embed__play {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		width: 100%;
		padding: 0 0 2rem;
		border: 0;
		font: 400 1.05rem/1.33 var(--font-sans);
		color: inherit;
		background: none;
		cursor: pointer;
	}

	.video-embed__play:focus-visible {
		outline-offset: -0.5rem;
	}

	.video-embed__icon {
		--size: clamp(3rem, 10vw, 4.5rem);
		width: var(--size);
		height: var(--size);
		padding: calc(var(--size) * 0.24);
		border-radius: 50%;
		fill: currentColor;
		background: var(--rust);
		box-shadow: var(--shadow);
		transition:
			color 200ms,
			background-color 200ms;
	}

	.video-embed__play:hover .video-embed__icon {
		color: var(--rust);
		background: var(--white);
	}

	.video-embed__play:hover span {
		text-decoration: underline;
	}

	/* Over the button, so clicks on the text still start the video. */
	.video-embed__note {
		position: absolute;
		inset: auto 0 0;
		margin: 0;
		padding: 0.6rem 1rem;
		font-size: 0.8rem;
		line-height: 1.4;
		text-align: center;
		pointer-events: none;
	}

	.video-embed__note a {
		color: inherit;
		pointer-events: auto;
	}

	.video-embed :global(iframe) {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
