---
interface Props {
	current: number;
	last: number;
	/** URL of page n */
	href: (page: number) => string;
}

const { current, last, href } = Astro.props;
const pages = [...new Set([1, current - 1, current, current + 1, last])].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);
---

{
	last > 1 && (
		<nav class="pagination" aria-label="Pages">
			{current > 1 && <a href={href(current - 1)}>« Previous</a>}
			{pages.map((page, index) => (
				<>
					{index > 0 && page - pages[index - 1] > 1 && <span>…</span>}
					{page === current ? <span aria-current="page">{page}</span> : <a href={href(page)}>{page}</a>}
				</>
			))}
			{current < last && <a href={href(current + 1)}>Next »</a>}
		</nav>
	)
}

<style>
	.pagination {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.35rem;
		margin-top: 2.5rem;
		font-size: 0.9rem;
	}

	a,
	span {
		padding: 0.15rem 0.55rem;
	}

	a {
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	[aria-current] {
		background: var(--blue-20);
	}
</style>
